# =============================================================================
# MediMind Backend — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---------- Server ----------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# ---------- MongoDB ----------
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_URI=mongodb://localhost:27017/medimind

# ---------- Redis / BullMQ ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT (split-token auth) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# ---------- PHI Field Encryption ----------
ENCRYPTION_KEY_AES256=

# ---------- AWS S3 (image uploads) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1

# ---------- AWS SNS (SMS / escalation messaging) ----------
AWS_SNS_REGION=us-east-1
AWS_SNS_SENDER_ID=MEDIMIND

# ---------- AWS SES (legacy transactional pipeline) ----------
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=no-reply@medimind.app

# ---------- Resend (OTP / password reset / caregiver invitation) ----------
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender identity shown in the recipient's inbox.
# Must be a domain verified in your Resend console. Format: "Name <email>".
# Defaults to 'MediMind <no-reply@medimind.app>' in code when unset.
EMAIL_FROM_ADDRESS=MediMind <no-reply@medimind.app>

# ---------- Web Push (VAPID) ----------
VAPID_SUBJECT=mailto:support@medimind.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- Rate Limiting ----------
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_MEDIA_MAX=20
RATE_LIMIT_MEDIA_WINDOW_MS=3600000
