# ==============================================================================
# MediMind Worker Engine — Environment Variables Template
# Copy this file to `.env` inside `worker/` directory.
# ==============================================================================

# ---------- Execution Setup ----------
NODE_ENV=development
LOG_LEVEL=info
WORKER_PORT=3001

# ---------- Internal Service Authentication ----------
WORKER_SECRET=secret_token_123
WORKER_INTERNAL_SECRET=secret_token_123

# ---------- Backend API Connectivity ----------
BACKEND_API_URL=http://127.0.0.1:8080/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1

# ---------- Caching & Async Queue (Redis / AWS ElastiCache) ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- Persistent Database (MongoDB / AWS DocumentDB) ----------
MONGO_URI=mongodb://127.0.0.1:27017/medimind

# ---------- AWS Cloud Messaging & Escalations ----------
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:medtrack-development-escalation-topic
SQS_QUEUE_ID=https://sqs.us-east-1.amazonaws.com/123456789012/medtrack-development-escalation-queue
SQS_QUEUE_ARN=arn:aws:sqs:us-east-1:123456789012:medtrack-development-escalation-queue
