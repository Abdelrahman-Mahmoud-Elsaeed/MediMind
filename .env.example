# ==============================================================================
# MediMind Platform — Root Environment Variables Template
# Copy this file to `.env` in the root directory for local dev & docker compose.
# ==============================================================================

# ---------- Node & Server Setup ----------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---------- Database (MongoDB / AWS DocumentDB) ----------
MONGO_ROOT_USER=medadmin
MONGO_ROOT_PASSWORD=supersecure_db_password123
MONGO_URI=mongodb://127.0.0.1:27017/medimind

# ---------- Redis & BullMQ Queue ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- Authentication & Security ----------
JWT_ACCESS_SECRET=bc82f3ef80dc4894392476d1e43bbcf5d1e2b5d4e892c90e1f7a3562a19c72e9
JWT_REFRESH_SECRET=8823f6d7ab71e4bf321096a605eddf83b28ee5390de2d103bf472ee91b05fc6a
COOKIE_SECRET=5e2bca810f723ea6df1b3e89cfcd922a
WORKER_SECRET=secret_token_123

# ---------- Field Encryption (AES-256) ----------
# Must be exactly 32 hex characters
ENCRYPTION_KEY_AES256=1234567890abcdef1234567890abcdef

# ---------- AWS Cloud Infrastructure (Terraform Provisioned) ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUptYKMK7qYMAPIE/K7MDENG/bPxRfiCYEXAMPLE
S3_BUCKET_NAME=medtrack-development-images
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:medtrack-development-escalation-topic
SQS_QUEUE_ID=https://sqs.us-east-1.amazonaws.com/123456789012/medtrack-development-escalation-queue

# ---------- Frontend Next.js Public URLs ----------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8080

# ---------- Email Services (Resend) ----------
RESEND_API_KEY=re_dummy_resend_api_key_123456789
EMAIL_FROM_ADDRESS=MediMind <no-reply@medimind.app>

# ---------- AI OCR Services (Gemini / Qwen) ----------
OCR_PROVIDER=gemini
GEMINI_API_KEY=dummy_gemini_api_key_1234567890
GEMINI_MODEL=gemini-3.6-flash
QWEN_API_KEY=dummy_qwen_api_key_1234567890
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# ---------- Web Push Notifications (VAPID) ----------
VAPID_SUBJECT=mailto:admin@medimind.app
VAPID_PUBLIC_KEY=BF_dummy_vapid_public_key_string_replace_this_later
VAPID_PRIVATE_KEY=dummy_vapid_private_key_string_replace_this_later

# ---------- Rate Limiting ----------
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_MEDIA_MAX=20
RATE_LIMIT_MEDIA_WINDOW_MS=3600000
